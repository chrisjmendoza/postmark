<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowBackground matches the Compose light background (Theme.kt) so cold
         start paints the right color instead of the platform default, and the
         values-night variant prevents the white-flash-then-dark-snap this
         dark-default app showed on every launch. -->
    <style name="Theme.Postmark" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF2F2F7</item>
    </style>
</resources>
